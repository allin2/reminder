<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111829"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏰"
        android:textSize="56sp" />

    <TextView
        android:id="@+id/alarmLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🚨 关键"
        android:textColor="#E2A3A3"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="安心收件箱"
        android:textColor="#F4F5F9"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="有一条事项需要你确认"
        android:textColor="#C9D0E0"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/alarmClockText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-light"
        android:text="00:00"
        android:textColor="#F2A93B"
        android:textSize="48sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnAck"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#24357A"
            android:text="我知道了"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSnooze"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#1E2A4A"
                android:text="稍后 2 小时"
                android:textColor="#C9D0E0"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#1E2A4A"
                android:text="完成"
                android:textColor="#C9D0E0"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="#171F35"
            android:text="关闭（只止响，不表态）"
            android:textColor="#6f7a86"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="「关闭」不会记作「我知道了」，后续提醒仍会继续"
        android:textColor="#6f7a86"
        android:textSize="12sp" />
</LinearLayout>
